from typing import Dict

import jax
import jax.numpy as jnp
import ml_collections
import numpy as np
from universal_diffusion.models import image
from universal_diffusion.models import model
from universal_diffusion.models import model_registry


def broadcast_to_shape_from_left(x: jnp.ndarray, shape):
  assert len(shape) >= x.ndim
  return jnp.broadcast_to(
      x.reshape(x.shape + (1,) * (len(shape) - x.ndim)), shape)


def log1mexp(x: jnp.ndarray):
  """Accurate computation of log(1 - exp(-x)) for x > 0."""
  # From James Townsend's PixelCNN++ code
  # Method from
  # https://cran.r-project.org/web/packages/Rmpfr/vignettes/log1mexp-note.pdf
  return jnp.where(x > jnp.log(2), jnp.log1p(-jnp.exp(-x)),
                   jnp.log(-jnp.expm1(-x)))


def diffusion_forward(*, x0: jnp.ndarray, logsnr: jnp.ndarray):
  """Forward diffusion process: q(z_t | x0)."""
  return {
      "mean": x0 * jnp.sqrt(jax.nn.sigmoid(logsnr)),
      "std": jnp.sqrt(jax.nn.sigmoid(-logsnr)),
      "var": jax.nn.sigmoid(-logsnr),
      "logvar": jax.nn.log_sigmoid(-logsnr),
  }


def diffusion_reverse(*, x0: jnp.ndarray, z_t: jnp.ndarray,
                      logsnr_s: jnp.ndarray, logsnr_t: jnp.ndarray):
  """Reverse diffusion process: q(z_s | z_t, x0)."""

  # Requires: logsnr_s > logsnr_t (i.e., s < t).

  alpha_st = jnp.sqrt((1. + jnp.exp(-logsnr_t)) / (1. + jnp.exp(-logsnr_s)))
  alpha_s = jnp.sqrt(jax.nn.sigmoid(logsnr_s))

  r = jnp.exp(logsnr_t - logsnr_s)  # SNR(t) / SNR(s)
  one_minus_r = -jnp.expm1(logsnr_t - logsnr_s)  # 1 - SNR(t) / SNR(s)
  log_one_minus_r = log1mexp(logsnr_s - logsnr_t)  # log(1 - SNR(t) / SNR(s))

  mean = r * alpha_st * z_t + one_minus_r * alpha_s * x0

  # var = one_minus_r * jax.nn.sigmoid(-logsnr_t)
  # logvar = log_one_minus_r + jax.nn.log_sigmoid(-logsnr_t)

  # Follows jonathanho's medium:0.3
  frac = 0.3
  min_logvar = log_one_minus_r + jax.nn.log_sigmoid(-logsnr_s)
  max_logvar = log_one_minus_r + jax.nn.log_sigmoid(-logsnr_t)
  logvar = frac * max_logvar + (1 - frac) * min_logvar
  var = jnp.exp(logvar)

  return {
      "mean": mean,
      "std": jnp.sqrt(var),
      "var": var,
      "logvar": logvar,
  }


def predict_eps_from_x0(*, z: jnp.ndarray, x0: jnp.ndarray,
                        logsnr: jnp.ndarray):
  """eps = (z - alpha * x0) / sigma."""
  logsnr = broadcast_to_shape_from_left(logsnr, z.shape)
  return jnp.sqrt(1.0 + jnp.exp(logsnr)) * (
      z - x0 * jax.lax.rsqrt(1.0 + jnp.exp(-logsnr)))


def predict_x0_from_eps(*, z: jnp.ndarray, eps: jnp.ndarray,
                        logsnr: jnp.ndarray):
  """x0 = (z - sigma * eps) / alpha."""
  logsnr = broadcast_to_shape_from_left(logsnr, z.shape)
  return jnp.sqrt(1.0 + jnp.exp(-logsnr)) * (
      z - eps * jax.lax.rsqrt(1.0 + jnp.exp(logsnr)))


@model_registry.register("diffusion")
class DiffusionModel(image.ImageModel):
  """Diffusion model."""

  def __init__(self, config: ml_collections.ConfigDict):
    super().__init__(config)

    assert config.diffusion.loss_norm in ("l1", "l2")
    assert config.diffusion.loss_type in (
        "eps", "x0", "max_x0_eps", "min_x0_eps", "x0_and_eps")
    assert config.diffusion.time_continuous_or_discrete in (
        "continuous", "discrete")

    assert config.diffusion.model_output in ("eps", "x0", "x0_and_eps")

    assert config.unet.max_time == 2e4

    if config.diffusion.model_output == "x0_and_eps":
      assert config.unet.output_ch == 6
    else:
      assert config.unet.output_ch == 3

  def make_init_variables(self, rng: jnp.ndarray):
    config = self.config

    init_kwargs = self.init_inputs(input_specs=config.unet.inputs)
    init_kwargs["train"] = False
    params_rng, dropout_rng = jax.random.split(rng, 2)
    return self.nn.init({
        "params": params_rng,
        "dropout": dropout_rng
    }, **init_kwargs)

  def get_logsnr_t(
      self, t: jnp.ndarray, schedule: ml_collections.ConfigDict) -> jnp.ndarray:
    """Return log-SNR at a given t for a given schedule.

    Args:
      t: The continuous time between [0.0, 1.0].
      schedule: The noise schedule.

    Returns:
      The log signal-to-noise ratio, in the current implementation
      logsnr_min == -20.0, and logsnr_max == 20.0.
    """
    # The range of logsnr value is clipped between [-20.0, 20.0]
    logsnr_min = -20.0
    logsnr_max = 20.0

    if schedule.name == "cosine":
      # This is based on the schedule alpha_cumprod_t = cos(t * pi / 2) ** 2.
      # Note that OpenAI cosine schedule is slightly different from this, where
      # alpha_cumprod_t = cos(((t + 0.008) / 1.008) * pi / 2) ** 2.
      b = np.arctan(np.exp(-0.5 * logsnr_max))
      a = np.arctan(np.exp(-0.5 * logsnr_min)) - b
      return -2.0 * jnp.log(jnp.tan(a * t + b))

    elif schedule.name == "linear":
      # A linear noise schedule where beta is linearly interpolated from
      # schedule.start to schedule.stop.
      num_steps = self.config.diffusion.num_steps
      betas = np.linspace(
          schedule.start, schedule.stop, num_steps, dtype=np.float64)
      alphas_cumprod = np.cumprod(1. - betas, axis=0)
      logsnr = np.log(alphas_cumprod) - np.log1p(-alphas_cumprod)
      # Clip the values between [-logsnr_min, logsnr_max]
      logsnr = np.clip(logsnr, a_min=logsnr_min, a_max=logsnr_max)
      return jnp.interp(t, np.linspace(0, 1, num_steps), logsnr)

    else:
      raise ValueError("Schedule %s not identified." % schedule.name)

  def fprop(self, *, cond: Dict[str, jnp.ndarray], z: jnp.ndarray,
            logsnr: jnp.ndarray, time: jnp.ndarray, train: bool, params,
            rng: jnp.ndarray):
    """Fprop the model network.

    Args:
      cond: The conditioning dict.
      z: The latent.
      logsnr: The logsnr.
      time: The time.
      train: True if train mode.
      params: The params.
      rng: The rng.

    Returns:
      A dict with:
        x0: The x0.
        eps: The eps.
    """
    config = self.config

    rngs = None
    if train:
      rngs = {"dropout": rng}

    # The time is in [0, 1] and is multiplied by x1000.
    # We directly condition the model on time for now. Conditioning on logsnr is
    # required when learning the noise schedule.
    model_output = self.nn.apply(
        {"params": params}, z, cond=cond, t=time * 1e3,
        train=train, rngs=rngs)

    if config.diffusion.model_output == "eps":
      outputs = {
          "eps": outputs,
          "x0": predict_x0_from_eps(z=z, eps=model_output, logsnr=logsnr),
      }
    elif config.diffusion.model_output == "x0":
      outputs = {
          "eps": predict_eps_from_x0(z=z, x0=model_output, logsnr=logsnr),
          "x0": outputs,
      }
    elif config.diffusion.model_output == "x0_and_eps":
      x0_, eps_ = jnp.split(model_output, 2, axis=-1)
      x0 = predict_x0_from_eps(z=z, eps=eps_, logsnr=logsnr)
      wx = broadcast_to_shape_from_left(jax.nn.sigmoid(-logsnr), z.shape)
      outputs = {
          "x0": wx * x0_ + (1. - wx) * x0,
          "eps": eps_
      }
    else:
      raise ValueError("Unknown model_output: %s" %
                       config.diffusion.model_output)

    if config.diffusion.model_output != "eps":
      outputs["eps"] = predict_eps_from_x0(
          z=z, x0=outputs["x0"], logsnr=logsnr)

    return outputs

  def loss(self, rng: jnp.ndarray, batch: Dict[str, jnp.ndarray], params):
    """The loss function."""
    config = self.config

    x0 = batch["tgt"]
    batch_size = x0.shape[0]

    rng, rng_eps, rng_t = jax.random.split(rng, 3)

    eps = jax.random.normal(rng_eps, shape=x0.shape)

    # Sample time.
    if config.diffusion.time_continuous_or_discrete == "continuous":
      time = jax.random.uniform(rng_t, (batch_size,))
    elif config.diffusion.time_continuous_or_discrete == "discrete":
      time = jax.random.randint(
          rng_t, (batch_size,), 0, config.diffusion.num_steps)
      time = (time.astype(jnp.float32) /
              float(config.diffusion.num_steps))
    else:
      raise ValueError("Invalid value for time_continuous_or_discrete: %s" %
                       config.diffusion.time_continuous_or_discrete)

    logsnr = self.get_logsnr_t(time, config.diffusion.schedule)

    # Sample z ~ q(z_t | x0).
    z_dist = diffusion_forward(
        x0=x0, logsnr=broadcast_to_shape_from_left(logsnr, x0.shape))
    z_t = z_dist["mean"] + z_dist["std"] * eps

    rng, split_rng = jax.random.split(rng, 2)
    cond = self.conditioning_dict(batch, train=True, rng=split_rng)
    outputs = self.fprop(
        cond=cond,
        z=z_t,
        logsnr=logsnr,
        time=time,
        train=True,
        params=params,
        rng=rng)

    def diffusion_loss(a, b):
      """L1 or L2."""
      if config.diffusion.loss_norm == "l1":
        loss = jnp.abs(a - b)
      elif config.diffusion.loss_norm == "l2":
        loss = jnp.square(a - b)
      else:
        raise ValueError("Unknown diffusion loss norm: %s" %
                         config.diffusion.loss_norm)

      mask = batch["mask"] if config.diffusion.use_masking else jnp.ones_like(
          batch["tgt"])
      loss = loss * mask
      loss = jnp.sum(loss, axis=tuple(range(1, len(a.shape))))
      mask_sum = jnp.sum(mask, axis=tuple(range(1, len(a.shape))))
      loss = loss / mask_sum

      return loss

    x0_loss = diffusion_loss(outputs["x0"], x0)
    eps_loss = diffusion_loss(outputs["eps"], eps)

    if config.diffusion.loss_type == "x0":
      loss = x0_loss
    elif config.diffusion.loss_type == "eps":
      loss = eps_loss
    elif config.diffusion.loss_type == "max_x0_eps":
      loss = jnp.maximum(x0_loss, eps_loss)
    # TODO(sahariac): is min(x0, eps) a meaningful loss?
    elif config.diffusion.loss_type == "min_x0_eps":
      loss = jnp.minimum(x0_loss, eps_loss)
    elif config.diffusion.loss_type == "x0_and_eps":
      loss = eps_loss + x0_loss
    else:
      raise ValueError("Unknown diffusion loss_type: %s" %
                       config.diffusion.loss_type)

    # Normalize by batch.
    loss = jnp.mean(loss, 0)

    return loss, outputs

  def ddim_step(self, i: jnp.ndarray, logsnr_s: jnp.ndarray,
                logsnr_t: jnp.ndarray, pred_x_t: jnp.ndarray,
                pred_eps_t: jnp.ndarray):
    """One step of DDIM."""
    del logsnr_t
    logsnr_s = broadcast_to_shape_from_left(logsnr_s, pred_x_t.shape)

    stdv_s = jnp.sqrt(jax.nn.sigmoid(-logsnr_s))
    alpha_s = jnp.sqrt(jax.nn.sigmoid(logsnr_s))
    z_s_pred = alpha_s * pred_x_t + stdv_s * pred_eps_t
    return jnp.where(i == 0, pred_x_t, z_s_pred)

  def ddpm_step(self, i: jnp.ndarray, rng: jnp.ndarray, logsnr_s: jnp.ndarray,
                logsnr_t: jnp.ndarray, pred_x0: jnp.ndarray,
                z_t: jnp.ndarray):
    """Sample one step."""
    logsnr_s = broadcast_to_shape_from_left(logsnr_s, pred_x0.shape)
    logsnr_t = broadcast_to_shape_from_left(logsnr_t, pred_x0.shape)

    eps = jax.random.normal(
        jax.random.fold_in(rng, i), shape=pred_x0.shape, dtype=pred_x0.dtype)

    z_s_dist = diffusion_reverse(
        x0=pred_x0, z_t=z_t, logsnr_s=logsnr_s, logsnr_t=logsnr_t)
    return jnp.where(i == 0, pred_x0, z_s_dist["mean"] + z_s_dist["std"] * eps)

  def eval_step(self, rng: jnp.ndarray, state: model.State,
                batch: Dict[str, jnp.ndarray]):
    """Eval step."""
    config = self.config

    params = state.params

    num_steps = config.diffusion.sampler.num_steps
    schedule = config.diffusion.sampler.get(
        "schedule", config.diffusion.schedule)

    init_z = jax.random.normal(rng, shape=batch["tgt"].shape, dtype=jnp.float32)
    init_vals = (num_steps - 1, init_z)

    batch_size = init_z.shape[0]

    def condition(vals):
      i, _ = vals
      return i >= 0

    def body(vals):
      i, z_t = vals
      t = (i + 1.0).astype(jnp.float32) / num_steps
      s = i.astype(jnp.float32) / num_steps
      logsnr_t = jnp.full((batch_size,), self.get_logsnr_t(t, schedule))
      logsnr_s = jnp.full((batch_size,), self.get_logsnr_t(s, schedule))
      time = jnp.full((batch_size,), t)

      cond = self.conditioning_dict(batch, train=False, rng=None)
      outputs = self.fprop(
          cond=cond,
          z=z_t,
          logsnr=logsnr_t,
          time=time,
          train=False,
          params=params,
          rng=None)
      pred_eps = outputs["eps"]
      pred_x0 = outputs["x0"]

      if (config.diffusion.get("classifier_free_guidance") is not None and
          config.diffusion.classifier_free_guidance.eval_condition_weight != 1):
        assert cond["feature"] is not None
        assert config.diffusion.model_output == "eps"
        cond["feature"] = jnp.zeros_like(cond["feature"])
        # Classifier-Free Diffusion Guidance, Ho and Salimans 2021
        cond_wt = config.diffusion.classifier_free_guidance.eval_condition_weight
        uncond_wt = 1. - cond_wt
        uncond_outputs = self.fprop(
            cond=cond,
            z=z_t,
            logsnr=logsnr_t,
            time=time,
            train=False,
            params=params,
            rng=None)
        pred_eps = cond_wt * pred_eps + uncond_wt * uncond_outputs["eps"]
        pred_x0 = predict_x0_from_eps(z=z_t, eps=pred_eps,
                                      logsnr=logsnr_t)
      # TODO(williamchan): Modify the sampler according to the mask.

      if config.diffusion.sampler.clip_x0:
        pred_x0 = jnp.clip(pred_x0, -1.0, 1.0)
        pred_eps = predict_eps_from_x0(z=z_t, x0=pred_x0, logsnr=logsnr_t)

      if config.diffusion.sampler.name == "ddim":
        z_t = self.ddim_step(i, logsnr_s, logsnr_t, pred_x0, pred_eps)
      elif config.diffusion.sampler.name == "ddpm":
        z_t = self.ddpm_step(i, rng, logsnr_s, logsnr_t, pred_x0, z_t)
      else:
        raise ValueError("Unknown sampler type: %s" %
                         config.diffusion.sampler.name)
      return (i - 1, z_t)

    _, pred_x0 = jax.lax.while_loop(condition, body, init_vals)
    return pred_x0
